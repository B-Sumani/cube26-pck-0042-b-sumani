# Database Configuration (PostgreSQL / Supabase)
# DATABASE_URL: Direct Postgres connection string for DDL migrations (using postgres / service admin role)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# DATABASE_APP_URL: Connection string using the non-bypass application role (pack_app_user) that strictly enforces RLS
DATABASE_APP_URL=postgresql://pack_app_user:[APP-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase API Credentials
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# Non-bypass client key (anon key) used for application requests subject to RLS
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service role key: ADMIN/MIGRATIONS ONLY. Never used for tenant-scoped application queries!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Vision Model Configuration
MODEL_PROVIDER=gemini
# Small model for fast dev iteration
MODEL_NAME=gemini-2.5-flash
# Stronger model for final evaluation
MODEL_NAME_EVAL=gemini-2.5-pro
GEMINI_API_KEY=your_gemini_api_key_here

# Packaging Station Configuration
STORAGE_BUCKET_NAME=pack-evidence-records
SIGNED_URL_EXPIRY_SECONDS=3600
